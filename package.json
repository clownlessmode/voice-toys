{
  "name": "voice-toys",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--localstorage-file=.next/localstorage' next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security": "npm run security:audit && npm run security:signatures && npm run security:lint",
    "security:audit": "audit-ci --moderate",
    "security:signatures": "npm audit signatures",
    "security:lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:cdek": "node scripts/test-cdek-integration.js",
    "test:cdek-real": "node scripts/test-real-cdek-integration.js",
    "test:cdek-existing": "node scripts/test-existing-order-cdek.js",
    "test:cdek-weight": "node scripts/test-weight-extraction.js",
    "test:cdek-single": "node scripts/test-single-order.js",
    "test:cdek-article": "node scripts/test-cdek-with-article.js",
    "test:promo-codes": "node scripts/test-promo-codes.js",
    "test:promo-codes-comprehensive": "node scripts/test-promo-codes-comprehensive.js",
    "test:promo-codes-api": "vitest run test/api/promo-codes.test.ts",
    "test:promo-codes-integration": "vitest run test/integration/promo-codes-integration.test.ts",
    "test:promo-codes-frontend": "vitest run test/frontend/promo-codes-frontend.test.ts",
    "test:promo-codes-all": "npm run test:promo-codes-api && npm run test:promo-codes-integration && npm run test:promo-codes-frontend",
    "update-schema-safely": "node scripts/update-schema-safely.js",
    "update-schema-incremental": "node scripts/update-schema-incremental.js",
    "update-schema-with-restore": "node scripts/update-schema-with-data-restore.js",
    "restore-data-from-backup": "node scripts/restore-data-from-backup.js",
    "restore-real-data": "node scripts/restore-real-data.js",
    "db:seed": "bun run prisma/seed.ts",
    "db:seed-orders": "bun run prisma/seed-orders.ts",
    "db:reset": "bun prisma db push --force-reset && bun run db:seed"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/formidable": "^3.5.1",
    "@types/multer": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "formidable": "^3.5.4",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "multer": "^2.2.0",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "write-excel-file": "^4.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitest/ui": "^4.1.10",
    "audit-ci": "^7.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
